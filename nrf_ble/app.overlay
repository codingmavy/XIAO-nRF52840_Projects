/ {
    aliases {
        nrf-irq = &my_nrf_irq_pin;
        new-led = &new_led;
    };

    custom_inputs {
        compatible = "gpio-keys";

        my_nrf_irq_pin: irq_pin {
            gpios = <&gpio0 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
    };

    custom_outputs {
        compatible = "gpio-leds";
        new_led: led {
            gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;

        };
    };
};
